# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java / Kotlin class files
*.class

# Generated build directories (universal wildcard)
**/build/
bin/
gen/
out/

# Gradle internal and cache files
.gradle/
gradle-app.setting
.gradletasknamecache

# Kotlin / KSP incremental build cache
.kotlin/
.ksp/

# Local configuration and environment properties
local.properties
secrets.properties
key.properties

# Proguard / R8 artifacts
proguard/

# Android Studio & IntelliJ IDEA project files
.idea/
*.iws
*.iml
*.ipr

# Android Studio captures, traces & heap dumps
*.hprof
*.prof
*.trace
captures/
.navigation/

# Signing keystores (NEVER commit release keystores)
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx

# VS Code workspace settings
.vscode/

# OS-specific files
.DS_Store
Thumbs.db
