    "views": [
      {
        "viewName": "wallet_balances",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT w.id AS walletId,\n          w.initialBalance\n          + COALESCE((SELECT SUM(amount) FROM transactions WHERE walletId = w.id AND type = 'INGRESO'), 0)\n          - COALESCE((SELECT SUM(amount) FROM transactions WHERE walletId = w.id AND type = 'GASTO'), 0)\n          - COALESCE((SELECT SUM(amount) FROM transactions WHERE walletId = w.id AND type = 'TRANSFERENCIA'), 0)\n          + COALESCE((SELECT SUM(amount) FROM transactions WHERE toWalletId = w.id AND type = 'TRANSFERENCIA'), 0)\n          - COALESCE((SELECT SUM(amount) FROM pocket_movements WHERE walletId = w.id), 0)\n          AS balance\n        FROM wallets w WHERE w.archived = 0"
      },
      {
        "viewName": "pocket_balances",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT p.id AS pocketId,\n          COALESCE((SELECT SUM(amount) FROM pocket_movements WHERE pocketId = p.id), 0) AS currentBalance\n        FROM pockets p WHERE p.archived = 0"
      }
    ],
